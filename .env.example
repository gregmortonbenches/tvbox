# --- TMDB -------------------------------------------------------------------
# A v4 "API Read Access Token" from https://www.themoviedb.org/settings/api
# (the long eyJ... JWT, NOT the short v3 API key).
#
# Never rename this to NEXT_PUBLIC_TMDB_* — that prefix inlines the value
# into the browser bundle and hands your token to anyone who views source.
TMDB_ACCESS_TOKEN=

# --- Database ---------------------------------------------------------------
# Any Postgres. Neon/Supabase/Vercel Postgres all work; hosted ones need ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tvbox

# --- Access -----------------------------------------------------------------
# Single shared password for the two of you. Anyone with this can read and
# write everything — there are no per-person permissions by design.
APP_PASSWORD=

# Signs the login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Recommendations (optional) ---------------------------------------------
# Set to have Claude generate recommendations from your ratings and history.
# Leave blank and the Recommendations page falls back to TMDB's own
# "similar shows" for titles you rated highly — no extra account needed.
ANTHROPIC_API_KEY=
